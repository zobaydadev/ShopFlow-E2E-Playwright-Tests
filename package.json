{
  "name": "shopflow-e2e-playwright-tests",
  "version": "1.0.0",
  "description": "End-to-end UI and API tests with Playwright and TypeScript using page objects and fixtures",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "20.17.6",
    "typescript": "5.6.3"
  }
}
